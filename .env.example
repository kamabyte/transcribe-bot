# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# --- Какой провайдер транскрибации использовать ---
# Варианты: groq | openai  (см. providers/registry.py)
PROVIDER=groq

# --- Ключи провайдеров (нужен только тот, что выбран в PROVIDER) ---
# Groq: бесплатный ключ -> https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# OpenAI (опционально) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Доступ ---
# Telegram ID тех, кто может пользоваться ботом, через запятую. Пусто = любой,
# кто найдёт бота, — и тратит ваш лимит провайдера. Свой ID: напишите боту,
# он ответит, или спросите @userinfobot.
ALLOWED_USERS=

# --- Необязательное ---
# Принудительно язык распознавания (ISO-639-1: ru, en, ...). Пусто = автоопределение.
LANGUAGE=

# Модель для кнопки «Отформатировать» (chat-модель того же провайдера).
# Пусто = дефолт: openai/gpt-oss-120b для groq, gpt-5-mini для openai.
FORMAT_MODEL=
